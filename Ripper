--// RipperNotMoving - Full Fixed Version

--==================================================
-- SERVICES
--==================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

--==================================================
-- CONFIG
--==================================================

local CONFIG = {
    Model = "rbxassetid://139732443027976",

    Speed = 215,
    Delay = 6.771,

    DamageEnabled = true,
    DamageRange = 100,
    DamageAmount = 999,

    -- Map destruction OFF
    ShatterLights = false,
    RepairLights = false,

    Earthquake = true,
    CameraShake = true,

    SpawnSound = "rbxassetid://6657340839",
    DespawnSound = "rbxassetid://1837829565",

    SpawnVolume = 2,
    DespawnVolume = 2,

    -- Death message
    DeathHint = "Hide",
    DeathCause = "Ripper"
}

--==================================================
-- LOAD SPAWNER
--==================================================

local SPAWNER_URL =
    "https://raw.githubusercontent.com/eoyoustme/Extremely/refs/heads/main/Ripper%20Spawner"

local Ripper

local success, result = pcall(function()
    return loadstring(game:HttpGet(SPAWNER_URL))()
end)

if not success then
    warn("[Ripper] Failed to load spawner:")
    warn(result)
    return
end

Ripper = result

if not Ripper then
    warn("[Ripper] Spawner returned nil.")
    return
end

if typeof(Ripper.Create) ~= "function" then
    warn("[Ripper] Create function was not found.")
    return
end

--==================================================
-- SOUND FUNCTION
--==================================================

local function playSound(soundId, parent, volume)
    if not parent then
        parent = workspace
    end

    task.spawn(function()
        local sound = Instance.new("Sound")

        sound.Name = "RipperSound"
        sound.SoundId = soundId
        sound.Volume = volume or 1
        sound.RollOffMaxDistance = 150
        sound.Parent = parent

        local ok = pcall(function()
            sound:Play()
        end)

        if not ok then
            sound:Destroy()
            return
        end

        sound.Ended:Wait()

        if sound then
            sound:Destroy()
        end
    end)
end

--==================================================
-- CREATE RIPPER
--==================================================

local createSuccess, Entity = pcall(function()

    return Ripper:Create({

        --==========================================
        -- ENTITY
        --==========================================

        Entity = {
            Name = "RipperNotMoving",
            Asset = CONFIG.Model,
            HeightOffset = 0
        },

        --==========================================
        -- MOVEMENT
        --==========================================

        Movement = {
            Speed = CONFIG.Speed,
            Delay = CONFIG.Delay,
            Reversed = false
        },

        --==========================================
        -- DAMAGE
        --==========================================

        Damage = {
            Enabled = CONFIG.DamageEnabled,
            Range = CONFIG.DamageRange,
            Amount = CONFIG.DamageAmount,
            IgnoreHiding = false
        },

        --==========================================
        -- REBOUND
        --==========================================

        Rebounding = {
            Enabled = true,
            Type = "Ambush",
            Min = 2,
            Max = 4,
            Delay = 2
        },

        --==========================================
        -- LIGHTS
        --==========================================

        Lights = {
            Flicker = {
                Enabled = true,
