end)

if not createSuccess or not Entity then
    warn("[Ripper] Failed to create entity.")
    warn(Entity)
    return
end

--==================================================
-- SPAWN CALLBACK
--==================================================

pcall(function()

    Entity:SetCallback("OnSpawned", function(entityModel)

        if not entityModel then
            return
        end

        -- Spawn sound
        playSound(
            CONFIG.SpawnSound,
            entityModel,
            CONFIG.SpawnVolume
        )

        -- Red visual effect
        pcall(function()

            local old =
                Lighting:FindFirstChild("RipperColorCorrection")

            if old then
                old:Destroy()
            end

            local effect =
                Instance.new("ColorCorrectionEffect")

            effect.Name = "RipperColorCorrection"
            effect.TintColor =
                Color3.fromRGB(255, 75, 75)

            effect.Contrast = 0.15
            effect.Saturation = 0.05
            effect.Brightness = 0

            effect.Parent = Lighting

        end)

    end)

end)

