local spawnCount = 0
local maxSpawn = 5

local function SpawnEntity()
    if spawnCount >= maxSpawn then
        return
    end

    spawnCount += 1

    local entity = spawner.Create({
        Entity = {
            Name = "Rebound",
            Asset = "rbxassetid://124600498030401",
            HeightOffset = 0
        },

        Lights = {
            Flicker = {
                Enabled = false,
                Duration = 1
            },
            Shatter = false,
            Repair = false
        },

        CameraShake = {
            Enabled = true
        },

        Movement = {
            Speed = 300,
            Delay = 6,
            Reversed = false
        },

        Rebounding = {
            Enabled = false
        },

        Damage = {
            Enabled = true,
            Range = 40,
            Amount = 9999
        },

        Crucifixion = {
            Enabled = false
        },

        Death = {
            Type = "Guiding",
            Hints = {"you die to rebound"},
            Cause = "die to rebound"
        }
    })

    entity:SetCallback("OnLookAt", function()
        -- DỪNG VÀ XOÁ SOUND CŨ
        if currentSound then
            currentSound:Stop()
            currentSound:Destroy()
            currentSound = nil
        end

        -- PHÁT SOUND MỚI KHI CALLBACK
        playSound(CALLBACK_SOUND_ID)

        -- Death cause
        local ReSt = game.ReplicatedStorage
        local Plr = game.Players.LocalPlayer

        ReSt.GameStats[
            "Player_" .. Plr.Name
        ].Total.DeathCause.Value = "die to rebound"
    end)

    entity:Run()
end

SpawnEntity()

local LatestRoom = workspace.CurrentRooms:WaitForChild(
