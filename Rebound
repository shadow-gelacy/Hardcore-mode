local spawner = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"
))()

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local Player = Players.LocalPlayer

local SOUND_ID = "rbxassetid://14093035297"

local spawnCount = 0
local maxSpawn = 5
local achievementGiven = false

local function playEntitySound()
    local sound = Instance.new("Sound")
    sound.Name = "EntitySpawnSound"
    sound.SoundId = SOUND_ID
    sound.Volume = 10
    sound.PlaybackSpeed = 1
    sound.Parent = SoundService
    sound:Play()

    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

local function isRebound(obj)
    return obj:IsA("Model")
        and obj.Name:lower():find("rebound") ~= nil
end

Workspace.DescendantAdded:Connect(function(obj)
    if isRebound(obj) then
        playEntitySound()
    end
end)

local MainColorCorrection = game.Lighting:FindFirstChild("MainColorCorrection")

if MainColorCorrection then
    MainColorCorrection.TintColor = Color3.fromRGB(0, 80, 255)
    MainColorCorrection.Contrast = 1

    TweenService:Create(
        MainColorCorrection,
        TweenInfo.new(2.5),
        {Contrast = 0}
    ):Play()

    TweenService:Create(
        MainColorCorrection,
        TweenInfo.new(80),
        {TintColor = Color3.fromRGB(255, 255, 255)}
    ):Play()
end

local function GiveAchievement()
    if achievementGiven then
        return
    end

    achievementGiven = true

    local success, AchievementGiver = pcall(function()
        return loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
        ))()
    end)

    if not success or not AchievementGiver then
        warn("Rebound achievement giver failed")
        return
    end

    pcall(function()
        AchievementGiver({
            Title = "Rebound",
            Desc = "It Keeps Coming Back",
            Reason = "Survive Rebound.",
            Image = "rbxassetid://71991942167206"
        })
    end)
end

local function CheckReboundFinished()
    if achievementGiven then
        return
    end

    if spawnCount < maxSpawn then
        return
    end

    task.spawn(function()
        while true do
            local reboundFound = false

            for _, obj in ipairs(Workspace:GetDescendants()) do
                if isRebound(obj) then
                    reboundFound = true
                    break
                end
            end

            if not reboundFound then
                task.wait(1)

                local stillThere = false

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if isRebound(obj) then
                        stillThere = true
                        break
                    end
                end

                if not stillThere then
                    GiveAchievement()
                    break
                end
            end

            task.wait(0.5)
        end
    end)
end

local function SpawnEntity()
    if spawnCount >= maxSpawn then
        CheckReboundFinished()
        return
    end

    spawnCount += 1

    local entity = spawner.Create({
        Entity = {
            Name = "Rebound",
            Asset = "rbxassetid://15930240494",
            HeightOffset = 0
        },

        Lights = {
            Flicker = {
                Enabled = false,
                Duration = 1
            },

            Shatter = false,
            Repair = false
        },

        CameraShake = {
            Enabled = true
        },

        Movement = {
            Speed = 90,
            Delay = 7,
            Reversed = false
        },

        Rebounding = {
            Enabled = false
        },

        Damage = {
            Enabled = true,
            Range = 40,
            Amount = 9999
        },

        Crucifixion = {
            Enabled = true,
            Range = 40,
            Resist = false,
            Break = true
        },

        Death = {
            Type = "Guiding",

            Hints = {
                "remember that",
                "it is called rebound",
                "he is rebound like ambush",
                "bye"
            }
        }
    })

    entity:SetCallback("OnLookAt", function()
        local GameStats = ReplicatedStorage:FindFirstChild("GameStats")

        if GameStats then
            local PlayerStats = GameStats:FindFirstChild("Player_" .. Player.Name)

            if PlayerStats
                and PlayerStats:FindFirstChild("Total")
                and PlayerStats.Total:FindFirstChild("DeathCause") then

                PlayerStats.Total.DeathCause.Value = "Rebound"
            end
        end
    end)

    entity:Run()

    if spawnCount >= maxSpawn then
        task.delay(1, CheckReboundFinished)
    end
end

SpawnEntity()

Workspace.CurrentRooms.ChildAdded:Connect(function(room)
    if spawnCount < maxSpawn then
        task.wait(1)
        SpawnEntity()
    end
end)
