			).Magnitude

		local timePassed =
			tick() - lastTeleportTime

		if timePassed >= cooldown then

			if dist > 300
				or (
					timePassed >= 15
					and dist > 40
				) then

				lastTeleportTime =
					tick()

				TeleportSkill()
			end
		end
	end
end)

