end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if room then
		print("Deer God entered:", room.Name)
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight then
		print("Player is looking at Deer God")
	end
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	print("Deer God damaged player:", newHealth)
end)

entity:SetCallback("OnDespawning", function()
	print("Deer God is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Deer God has completely despawned")

	task.wait(0.15)

	giveAchievement()
end)

entity:Run(true)
