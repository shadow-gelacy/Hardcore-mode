--------------------------------------------------
-- MODEL LOADER
--------------------------------------------------

local function getgithubmodeL(url)
	if not (writefile and getcustomasset and request) then
		return nil
	end

	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"

	local success, response = pcall(function()
		return request({
			Url = url,
			Method = "GET"
		})
	end)

	if not success or not response then
		return nil
	end

	if response.StatusCode ~= 200 then
		return nil
	end

	local okWrite = pcall(function()
		writefile(fileName, response.Body)
	end)

	if not okWrite then
		return nil
	end

	local assetId = getcustomasset(fileName)

	local success2, result = pcall(function()
		return game:GetObjects(assetId)[1]
	end)

	if success2 then
		return result
	end

	return nil
end

--------------------------------------------------
-- SOUND LOADER
--------------------------------------------------

local function GetGitSound(GithubSnd, SoundName)
	if not (
		writefile
		and isfile
		and getcustomasset
		and game.HttpGet
	) then
		return nil
	end

	local fileName = SoundName .. ".mp3"

	if not isfile(fileName) then
		local success, content = pcall(function()
			return game:HttpGet(GithubSnd)
		end)

		if not success or not content then
			return nil
		end

		writefile(fileName, content)
	end

	local sound = Instance.new("Sound")

	local getasset = getcustomasset or getsynasset

	if getasset then
		sound.SoundId = getasset(fileName)
	end

	return sound
end

