	local function updateViewportFrame()

		if not portalPart
			or not workspace.CurrentCamera then
			return
		end

		local cam =
			workspace.CurrentCamera

		local rayParams =
			RaycastParams.new()

		rayParams.FilterType =
			Enum.RaycastFilterType.Exclude

		rayParams.FilterDescendantsInstances = {
			Character,
			deergod,
			portalPart
		}

		local camPos =
			cam.CFrame.Position

		local rayResult =
			workspace:Raycast(
				camPos,
				portalPart.Position - camPos,
				rayParams
			)

		if rayResult
			and rayResult.Instance
			and rayResult.Instance.CanCollide then

			targetViewport.Visible = false
			return
		end

		local baseCamCF =
			portalCFrame

		if clonedPortal then

			local cameraPart =
				clonedPortal:FindFirstChild(
					"CameraPart",
					true
				)

			if not cameraPart then
				cameraPart =
					clonedPortal:FindFirstChild(
						"Camera",
						true
					)
			end

			if cameraPart then
				baseCamCF =
					cameraPart.CFrame
			end
		end

		local relativeRotation =
			portalCFrame.Rotation:ToObjectSpace(
				cam.CFrame.Rotation
			)

		vpCamera.CFrame =
			CFrame.new(
				baseCamCF.Position
			)
			* (
				baseCamCF.Rotation
				* relativeRotation
			)
			* CFrame.fromOrientation(
				0,
				math.pi,
				0
			)

		vpCamera.FieldOfView =
			cam.FieldOfView

		local cf =
			portalPart.CFrame

		local halfSize =
			portalPart.Size / 2

		local corners = {
			cf * Vector3.new(
				-halfSize.X,
				-halfSize.Y,
				0
			),

			cf * Vector3.new(
				halfSize.X,
				-halfSize.Y,
				0
			),

			cf * Vector3.new(
				-halfSize.X,
				halfSize.Y,
				0
			),

			cf * Vector3.new(
				halfSize.X,
				halfSize.Y,
				0
			)
		}

		local minX =
			math.huge

		local minY =
			math.huge

		local maxX =
			-math.huge

		local maxY =
			-math.huge

		local visible = false

		for _, corner in ipairs(corners) do

			local screenPos =
				cam:WorldToViewportPoint(
					corner
				)

			if screenPos.Z > 0 then

				visible = true

				minX =
					math.min(
						minX,
						screenPos.X
					)

				minY =
					math.min(
						minY,
						screenPos.Y
					)

				maxX =
					math.max(
						maxX,
						screenPos.X
					)

				maxY =
					math.max(
						maxY,
						screenPos.Y
					)
			end
		end

		if visible
			and maxX > minX
			and maxY > minY then

			targetViewport.Visible = true

			targetViewport.Position =
				UDim2.fromOffset(
					minX,
					minY
				)

			targetViewport.Size =
				UDim2.fromOffset(
					maxX - minX,
					maxY - minY
				)

		else

			targetViewport.Visible = false

		end
	end

