--------------------------------------------------
-- FIND CLOSEST WALL
--------------------------------------------------

local function FindClosestWall()

	if not Character then
		return nil, nil, nil
	end

	local hrp =
		Character:FindFirstChild("HumanoidRootPart")
		or Character.PrimaryPart

	if not hrp then
		return nil, nil, nil
	end

	local origin = hrp.Position

	local bestHitPart
	local bestHitPos
	local bestHitNormal

	local shortestDist = math.huge

	local rayParams = RaycastParams.new()

	rayParams.FilterType =
		Enum.RaycastFilterType.Exclude

	rayParams.FilterDescendantsInstances = {
		Character,
		deergod
	}

	for angle = 0, 330, 30 do

		local rad = math.rad(angle)

		local dir = Vector3.new(
			math.cos(rad),
			0,
			math.sin(rad)
		).Unit

		local result = workspace:Raycast(
			origin,
			dir * 60,
			rayParams
		)

		if result
			and result.Instance
			and result.Instance:IsA("BasePart")
			and result.Instance.CanCollide then

			if math.abs(result.Normal.Y) < 0.5 then

				local dist = result.Distance

				if dist < shortestDist then

					shortestDist = dist
					bestHitPart = result.Instance
					bestHitPos = result.Position
					bestHitNormal = result.Normal

				end
			end
		end
	end

	return bestHitPart, bestHitPos, bestHitNormal
end

