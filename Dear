entity:SetCallback("OnSpawned", function()
	local entityModel =
		entity.Model
		or Workspace:FindFirstChild("deer god")
		or Workspace:FindFirstChild("RushNew")

	if not entityModel then
		warn("Deer God model not found")
		return
	end

	task.wait(0.1)

	for _, obj in ipairs(entityModel:GetDescendants()) do
		if obj:IsA("Decal") or obj:IsA("Texture") then
			obj:Destroy()
		end
	end

	local attachment =
		entityModel:FindFirstChild("Attachment", true)

	if attachment then
		for _, obj in ipairs(attachment:GetDescendants()) do
			if obj:IsA("ParticleEmitter") then
				obj.Texture =
					"rbxassetid://111660043602194"
			end
		end

		local pointLights = {}

		for _, obj in ipairs(attachment:GetChildren()) do
			if obj:IsA("PointLight") then
				table.insert(pointLights, obj)
			end
		end

		if #pointLights > 0 then
			for i = 2, #pointLights do
				pointLights[i]:Destroy()
			end

			pointLights[1].Brightness = 5
			pointLights[1].Range = 25
			pointLights[1].Color =
				Color3.fromRGB(160, 32, 240)
		end
	end

	local footsteps =
		entityModel:FindFirstChild("Footsteps", true)

	if footsteps then
		footsteps:Destroy()
	end

	local playSoundObject =
		entityModel:FindFirstChild("PlaySound", true)

	if playSoundObject then
		playSoundObject:Destroy()
	end

	local indicate =
		entityModel:FindFirstChild("indicate", true)

	if indicate then
		indicate:Destroy()
	end

	local primaryPart =
		entityModel:FindFirstChild("PrimaryPart")
		or entityModel.PrimaryPart
		or entityModel:FindFirstChildWhichIsA("BasePart")

	if primaryPart then
		local sound = Instance.new("Sound")

		sound.Name = "CustomRushSound"
		sound.SoundId = getcustomasset(soundFileName)
		sound.Volume = 4000
		sound.RollOffMaxDistance = 10000
		sound.RollOffMinDistance = 500
		sound.Looped = true
		sound.Parent = primaryPart

		sound:Play()
	end

	print("Deer God has spawned")
end)

entity:SetCallback("OnStartMoving", function()
