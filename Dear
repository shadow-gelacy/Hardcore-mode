local Spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

local soundFileName = "deer_god_audio.mp3"
local soundUrl = "https://raw.githubusercontent.com/rrealblueyt-oss/Mp3/main/Deer%20god.mp3"

if not isfile(soundFileName) then
	writefile(soundFileName, game:HttpGet(soundUrl))
end

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local achievementGiver = loadstring(
	game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
	)
)()

local achievementGiven = false

local function giveAchievement()
	if achievementGiven then
		return
	end

	achievementGiven = true

	local success, err = pcall(function()
		achievementGiver({
			Title = "last chance to look away",
			Desc = "why are you running?",
			Reason = "Encounter Deer God.",
			Image = "rbxassetid://80090870845373"
		})
	end)

	if not success then
		warn("Deer God achievement failed:", err)
	end
end

local modelAssetId = "rbxassetid://115367508697896"
