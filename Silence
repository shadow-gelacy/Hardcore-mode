local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LatestRoom = ReplicatedStorage
	:WaitForChild("GameData")
	:WaitForChild("LatestRoom")

local Spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

local achievementGiver = loadstring(
	game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
	)
)()

local achievementGiven = false

local function GiveAchievement()
	if achievementGiven then
		return
	end

	achievementGiven = true

	pcall(function()
		achievementGiver({
			Title = "Quietness",
			Desc = "Don't Make A Sound",
			Reason = "Encounter Silence.",
			Image = "rbxassetid://94915462311154"
		})
	end)
end

local function WaitForSilenceToDisappear(model)
	if not model then
		return
	end

	local timeout = 10
	local start = tick()

	while model.Parent and tick() - start < timeout do
		task.wait(0.05)
	end

	task.wait(0.1)

	if not model.Parent then
		GiveAchievement()
	end
end

