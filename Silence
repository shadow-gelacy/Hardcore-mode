--------------------------------------------------
-- DAMAGE PLAYER
--------------------------------------------------

entity:SetCallback("OnDamagePlayer", function(newHealth)

	print("Silence damaged the player")

	local player = Players.LocalPlayer

	if not player then
		return
	end

	local character = player.Character
		or player.CharacterAdded:Wait()

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	local hrp = character:FindFirstChild(
		"HumanoidRootPart"
	)

	if not humanoid or not hrp then
		return
	end

	--------------------------------------------------
	-- TÌM ENTITY
	--------------------------------------------------

	local entityModel =
		Workspace:FindFirstChild("RipperNotMoving")

	if not entityModel then
		entityModel =
			Workspace:FindFirstChild("silence")
	end

	if not entityModel then
		warn("Silence model not found")
		humanoid:TakeDamage(367)
		return
	end

	--------------------------------------------------
	-- TÌM RIPE
	--------------------------------------------------

	local primaryPart =
		entityModel:FindFirstChild("Ripe", true)

	if not primaryPart
		or not primaryPart:IsA("BasePart") then

		warn("Silence Ripe part not found")

		humanoid:TakeDamage(367)
		return
	end

	--------------------------------------------------
	-- ENTITY BAY ĐẾN PLAYER
	--------------------------------------------------

	primaryPart.Anchored = true

	local tween = TweenService:Create(
		primaryPart,

		TweenInfo.new(
			1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),

		{
			CFrame =
				hrp.CFrame *
				CFrame.new(0, 4, 0)
		}
	)

	tween:Play()

	task.wait(0.7)

	--------------------------------------------------
	-- NẾU PLAYER ĐANG TRỐN
	--------------------------------------------------

	if character:GetAttribute("Hiding") then
		tween:Destroy()
		return
	end

	--------------------------------------------------
	-- DAMAGE
	--------------------------------------------------

	humanoid:TakeDamage(367)

	--------------------------------------------------
	-- KHÓA PLAYER
	--------------------------------------------------

	local originalWalkSpeed =
		humanoid.WalkSpeed

	local originalJumpPower =
		humanoid.JumpPower

	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0

	--------------------------------------------------
	-- DISABLE CONTROL
	--------------------------------------------------

	local controls

	pcall(function()
		controls = require(
			player
				:WaitForChild("PlayerScripts")
				:WaitForChild("PlayerModule")
		):GetControls()

		controls:Disable()
	end)

	--------------------------------------------------
	-- CAMERA LOOK ENTITY
	--------------------------------------------------

	local camera =
		Workspace.CurrentCamera

	local oldCameraType =
		camera.CameraType

	camera.CameraType =
		Enum.CameraType.Scriptable

	local running = true

	local connection

	connection = RunService.RenderStepped:Connect(
		function()

			if not running then
				return
			end

			if not primaryPart
				or not primaryPart.Parent then

				return
			end

			if not camera then
				return
			end

			camera.CFrame =
				CFrame.lookAt(
					camera.CFrame.Position,
					primaryPart.Position
				)
		end
	)

	--------------------------------------------------
	-- KHÔNG STATIC
	-- KHÔNG ẢNH JUMPSCARE
	-- KHÔNG SOUND
	--------------------------------------------------

	task.wait(0.8)

	--------------------------------------------------
	-- KẾT THÚC
	--------------------------------------------------

	running = false

	if connection then
		connection:Disconnect()
	end

	if humanoid and humanoid.Parent then
		humanoid.Health = 0
	end

	if entityModel
		and entityModel.Parent then

		entityModel:Destroy()
	end

	camera.CameraType =
		Enum.CameraType.Custom

	--------------------------------------------------
	-- RESTORE
	--------------------------------------------------

	if humanoid
		and humanoid.Parent
		and humanoid.Health > 0 then

		humanoid.WalkSpeed =
			originalWalkSpeed

		humanoid.JumpPower =
			originalJumpPower

		if controls then
			controls:Enable()
		end
	end
end)

