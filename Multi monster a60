					)
				]

			--==================================================
			-- IMAGE TWEEN
			--==================================================

			local Tween =
				TweenService:Create(

					Image,

					TweenInfo.new(
						0.5,
						Enum.EasingStyle.Sine,
						Enum.EasingDirection.Out
					),

					{
						ImageTransparency = 0,

						Rotation =
							math.random(
								-20,
								20
							),

						Size =
							UDim2.new(
								0,
								800,
								0,
								800
							)
					}
				)

			Tween:Play()

			Tween.Completed:Wait()

			--==================================================
			-- DEATH
			--==================================================

			if CameraConnection then

				CameraConnection:Disconnect()

				CameraConnection =
					nil
			end

			if A60
				and A60.Parent then

				A60:Destroy()
			end

			pcall(function()

				Humanoid.Health = 0

			end)

			pcall(function()

