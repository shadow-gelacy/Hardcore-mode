--==================================================
-- CAMERA SHAKE
--==================================================

local function CameraShake(
	Magnitude,
	Roughness,
	FadeIn,
	FadeOut,
	PositionInfluence,
	RotationInfluence
)

	local Success, Module = pcall(function()
		return require(
			ReplicatedStorage.CameraShaker
		)
	end)

	if not Success or not Module then
		return
	end

	local CurrentCamera =
		Workspace.CurrentCamera

	local Shake = Module.new(
		Enum.RenderPriority.Camera.Value,

		function(CF)
			CurrentCamera.CFrame =
				CurrentCamera.CFrame * CF
		end
	)

	Shake:Start()

	Shake:ShakeOnce(
		Magnitude,
		Roughness,
		FadeIn,
		FadeOut,
		PositionInfluence,
		RotationInfluence
	)
end

