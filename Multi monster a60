--==================================================
-- CAMERA SHAKE
--==================================================

local function CameraShake(
	Magnitude,
	Roughness,
	FadeIn,
	FadeOut,
	PositionInfluence,
	RotationInfluence
)

	local Success, Module = pcall(function()
		return require(
			ReplicatedStorage.CameraShaker
		)
	end)

	if not Success or not Module then
		return
	end

	local CurrentCamera = Workspace.CurrentCamera

	local Shake = Module.new(
		Enum.RenderPriority.Camera.Value,

		function(CF)
			CurrentCamera.CFrame =
				CurrentCamera.CFrame * CF
		end
	)

	Shake:Start()

	Shake:ShakeOnce(
		Magnitude,
		Roughness,
		FadeIn,
		FadeOut,
		PositionInfluence,
		RotationInfluence
	)
end

--==================================================
-- GET A60
--==================================================

local function GetA60()

	local A60 = Workspace:FindFirstChild("A60")

	if not A60 then
		A60 = Workspace:WaitForChild("A60", 10)
	end

	return A60
end

--==================================================
-- ON SPAWN
--==================================================

Entity:SetCallback(
	"OnSpawned",
	function()

		-- No red lighting.
		-- No ColorCorrection changes.

		--==================================================
		-- CAMERA SHAKE
		--==================================================

		CameraShake(
			40,
			70,
			0,
			4,
			2,
			12
		)

		--==================================================
		-- EARTHQUAKE
		--==================================================

		pcall(function()

			local CameraShaker =
				require(
					ReplicatedStorage.CameraShaker
				)

			local Shake =
				CameraShaker.new(
					Enum.RenderPriority.Camera.Value,

					function(CF)
						Workspace.CurrentCamera.CFrame =
							Workspace.CurrentCamera.CFrame * CF
					end
				)

			Shake:Start()

			Shake:Shake(
				CameraShaker.Presets.Earthquake
			)
		end)

		--==================================================
		-- FIND MODEL
		--==================================================

		local A60 = GetA60()

		if not A60 then
			warn("A60 was not found.")
			return
		end

		local RushNew =
			A60:FindFirstChild(
				"RushNew",
				true
			)

		if RushNew
			and RushNew:IsA("BasePart") then

			RushNew.CanCollide = false
		end

		--==================================================
		-- FACE EFFECT
		--==================================================

		local Face =
			A60:FindFirstChild(
				"Face",
				true
			)

		local Running = true

		local Textures = {
			"rbxassetid://79456435735915",
			"rbxassetid://82727826738371",
			"rbxassetid://114398760531594",
			"rbxassetid://109665802074437",
			"rbxassetid://110910840590527",
			"rbxassetid://71917470287498",
			"rbxassetid://110105532069108"
		}

		if Face and Face:IsA("ParticleEmitter") then

			task.spawn(function()

				while Running and Face.Parent do

					for _, Texture in ipairs(Textures) do

						if not Running then
							break
						end

						if Face.Parent then
							Face.Texture = Texture
						end

						task.wait(0.1)
					end
				end
			end)
		end

		--==================================================
		-- DESPAWN
		--==================================================

		Entity:SetCallback(
			"OnDespawning",
			function()

				Running = false

				CameraShake(
					40,
					70,
					0,
					4,
					2,
					12
				)

				--==================================================
				-- ACHIEVEMENT
				--==================================================

				pcall(function()

					local AchievementGiver =
						loadstring(game:HttpGet(
							"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
						))()

					AchievementGiver({

						Title = "The Multi-Faces",

						Desc = "woah...",

						Reason =
							"Survive A-60 (Multimonster)",

						Image =
							"rbxassetid://138429651291676"
					})
				end)

				--==================================================
				-- NO RED LIGHTING
				--==================================================

				-- Intentionally empty.
				-- No ColorCorrection.
				-- No red flash.
				-- No screen tint.

				--==================================================
				-- B60 20%
				--==================================================

				if math.random(1, 100) <= 20 then

					pcall(function()

						loadstring(game:HttpGet(
							"https://raw.githubusercontent.com/eoyoustme/Extremely/refs/heads/main/B60"
						))()

					end)
				end
			end
		)
	end
)

--==================================================
-- ON DAMAGE
--==================================================

Entity:SetCallback(
	"OnDamagePlayer",
	function(NewHealth)

		if NewHealth == 0 then
			return
		end

		task.spawn(function()

			--==================================================
			-- NO RED LIGHTING
			--==================================================

			-- Removed completely.
			-- No red ColorCorrection.
			-- No contrast flash.

			--==================================================
			-- CHARACTER
			--==================================================

			local Character =
				Player.Character
				or Player.CharacterAdded:Wait()

			local Humanoid =
				Character:WaitForChild(
					"Humanoid"
				)

			local RootPart =
				Character:WaitForChild(
					"HumanoidRootPart"
				)

			local A60 =
				Workspace:FindFirstChild(
					"A60"
				)

			if not A60 then
				return
			end

			local PrimaryPart =
				A60:FindFirstChild(
					"RushNew",
					true
				)

			if not PrimaryPart then
				return
			end

			--==================================================
			-- STOP SOUND
			--==================================================

			local SavedSounds = {}

			for _, Object in ipairs(
				game:GetDescendants()
			) do

				if Object:IsA("Sound")
					and Object.IsPlaying then

					Object:Stop()

					table.insert(
						SavedSounds,
						Object
					)
				end
			end

			--==================================================
			-- JUMPSCARE SOUND
			--==================================================

			task.wait(0.3)

			local Sound =
				Instance.new("Sound")

			Sound.SoundId =
				"rbxassetid://103959751518518"

			Sound.Volume = 5
			Sound.Parent = Workspace
			Sound:Play()

			--==================================================
			-- MOVE A60
			--==================================================

			PrimaryPart.Anchored = true

			pcall(function()
				A60.PrimaryPart = PrimaryPart
			end)

			local TargetPosition =
				RootPart.Position
				+ RootPart.CFrame.LookVector * 10

			local MoveTween =
				TweenService:Create(

					PrimaryPart,

					TweenInfo.new(0.1),

					{
						CFrame =
							CFrame.new(
								TargetPosition,
								Camera.CFrame.Position
							)
					}
				)

			MoveTween:Play()
			MoveTween.Completed:Wait()

			--==================================================
			-- LOCK PLAYER
			--==================================================

			Humanoid.WalkSpeed = 0
			Humanoid.JumpPower = 0
			Humanoid.PlatformStand = true

			--==================================================
			-- CAMERA
			--==================================================

			local CameraConnection

			CameraConnection =
				RunService.RenderStepped:Connect(
					function()

						if not Character.Parent then
							return
						end

						if Character:GetAttribute(
							"Hiding"
						) then

							if CameraConnection then

								CameraConnection:Disconnect()
								CameraConnection = nil
							end

							for _, SavedSound in ipairs(
								SavedSounds
							) do

								if SavedSound
									and SavedSound.Parent then

									SavedSound:Play()
								end
							end

							PrimaryPart.Anchored = false
							Humanoid.PlatformStand = false

							return
						end

						if not PrimaryPart
							or not PrimaryPart.Parent then

							if CameraConnection then
								CameraConnection:Disconnect()
								CameraConnection = nil
							end

							return
						end

						local DesiredPosition =
							Camera.CFrame.Position
							+ Camera.CFrame.LookVector * 5

						PrimaryPart.CFrame =
							CFrame.new(
								DesiredPosition,
								Camera.CFrame.Position
							)

						Camera.CFrame =
							CFrame.lookAt(
								Camera.CFrame.Position,
								PrimaryPart.Position
							)
					end
				)

			--==================================================
			-- IMAGE JUMPSCARE
			--==================================================

			task.wait(1.3)

			if Character:GetAttribute(
				"Hiding"
			) then
				return
			end

			local Images = {
				"18801391735",
				"119227604541887",
				"18801488141",
				"16501050923",
				"17019901366",
				"14472562848",
				"111160375045680"
			}

			local Gui =
				Instance.new("ScreenGui")

			Gui.Name = "A60Jumpscare"
			Gui.IgnoreGuiInset = true
			Gui.ResetOnSpawn = false
			Gui.DisplayOrder = 999999
			Gui.Parent = Player.PlayerGui

			local Image =
				Instance.new("ImageLabel")

			Image.Parent = Gui
			Image.BackgroundTransparency = 1
			Image.AnchorPoint = Vector2.new(0.5, 0.5)

			Image.Position =
				UDim2.new(
					0.5,
					0,
					0.5,
					0
				)

			Image.Size =
				UDim2.new(
					0,
					50,
					0,
					50
				)

			Image.ImageTransparency = 1

			Image.ImageColor3 =
				Color3.fromRGB(
					255,
					0,
					0
				)

			Image.Image =
				"rbxassetid://"
				.. Images[
					math.random(
						1,
						#Images
					)
				]

			--==================================================
			-- IMAGE TWEEN
			--==================================================

			local Tween =
				TweenService:Create(

					Image,

					TweenInfo.new(
						0.5,
						Enum.EasingStyle.Sine,
						Enum.EasingDirection.Out
					),

					{
						ImageTransparency = 0,

						Rotation =
							math.random(
								-20,
								20
							),

						Size =
							UDim2.new(
								0,
								800,
								0,
								800
							)
					}
				)

			Tween:Play()
			Tween.Completed:Wait()

			--==================================================
			-- DEATH
			--==================================================

			if CameraConnection then

				CameraConnection:Disconnect()
				CameraConnection = nil
			end

			if A60 and A60.Parent then
				A60:Destroy()
			end

			pcall(function()
				Humanoid.Health = 0
			end)

			pcall(function()

				local Stats =
					ReplicatedStorage.GameStats[
						"Player_" .. Player.Name
					]

				Stats.Total.DeathCause.Value =
					"Multi Monster"
			end)

			task.wait(2)

			if Gui and Gui.Parent then
				Gui:Destroy()
			end

			--==================================================
			-- DEATH ACHIEVEMENT
			--==================================================

			pcall(function()

				local AchievementGiver =
					loadstring(game:HttpGet(
						"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
					))()

				AchievementGiver({

					Title = "rooms?",

					Desc = "that great",

					Reason = "Death by A-60",

					Image =
						"rbxassetid://119763403416005"
				})
			end)
		end)
	end
)

