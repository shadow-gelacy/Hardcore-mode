			task.wait(2)

			if Gui
				and Gui.Parent then

				Gui:Destroy()
			end

			--==================================================
			-- DEATH ACHIEVEMENT
			--==================================================

			pcall(function()

				local AchievementGiver =
					loadstring(game:HttpGet(
						"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
					))()

				AchievementGiver({

					Title =
						"Death By Multi-Png",

					Desc =
						"That's obvious.",

					Reason =
						"Death by A-60",

					Image =
						"rbxassetid://132714224363069"
				})

			end)
		end)
	end
)

--==================================================
-- BLACKLIST
--==================================================

local Blacklist = {

	"key",
	"breaker",
	"gold",
	"floor",
	"wall",
	"ceiling"
}

local function IsBlacklisted(Name)

	local LowerName =
		Name:lower()

	for _, Word in ipairs(
		Blacklist
	) do

		if string.find(
			LowerName,
			Word,
			1,
			true
		) then

			return true
		end
	end

	return false
end

local function IsInsideBlacklistedModel(
	Object
)

	local Current =
		Object.Parent

	while Current
		and Current ~= Workspace do

		if Current:IsA("Model")
			and IsBlacklisted(
				Current.Name
			) then

			return true
		end

		Current =
			Current.Parent
	end

	return false
end

--==================================================
-- ENTER ROOM
--==================================================

Entity:SetCallback(
	"OnEnterRoom",
	function(
		Room: Model,
		FirstTime: boolean
	)

		for _, Object in ipairs(
			Room:GetDescendants()
		) do

			if Object:IsA("BasePart") then

				-- Protect player models
				local Model =
					Object:FindFirstAncestorOfClass(
						"Model"
					)

				if Model
					and Model:FindFirstChildOfClass(
						"Humanoid"
					) then

					continue
				end

				--==================================================
				-- PROTECT DOORS
				--==================================================

				local IsDoor =
					false

				if string.find(
					Object.Name:lower(),
					"door",
					1,
					true
				) then

					IsDoor =
						true

				elseif Object.Parent
					and string.find(
						Object.Parent.Name:lower(),
						"door",
						1,
						true
					) then

					IsDoor =
						true
				end

				if IsDoor then
					continue
				end

				--==================================================
				-- BLACKLIST
				--==================================================

				if IsBlacklisted(
					Object.Name
				) then

					continue
				end

				if IsInsideBlacklistedModel(
					Object
				) then

					continue
				end

				--==================================================
				-- PHYSICS
				--==================================================

				Object.Anchored =
					true

				task.wait()

				Object.Anchored =
					false

				Object.Massless =
					true

				Object.CanCollide =
					false

				Object.CanQuery =
					false

				Object.AssemblyLinearVelocity =
					Vector3.new(
						math.random(
							-150,
							150
						),

						50,

						math.random(
							-180,
							180
						)
					)

				Object.AssemblyAngularVelocity =
					Vector3.new(
						math.random(
							-25,
							25
						),

						math.random(
							-25,
							25
						),

						math.random(
							-25,
							25
						)
					)
			end
		end
	end
)

