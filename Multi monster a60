				TweenService:Create(
					CC,

					TweenInfo.new(20),

					{
						TintColor =
							Color3.fromRGB(
								255,
								255,
								255
							)
					}
				):Play()
			end

			--==================================================
			-- CHARACTER
			--==================================================

			local Character =
				Player.Character
				or Player.CharacterAdded:Wait()

			local Humanoid =
				Character:WaitForChild(
					"Humanoid"
				)

			local RootPart =
				Character:WaitForChild(
					"HumanoidRootPart"
				)

			local A60 =
				Workspace:FindFirstChild(
					"A60"
				)

			if not A60 then
				return
			end

			local PrimaryPart =
				A60:FindFirstChild(
					"RushNew",
					true
				)

			if not PrimaryPart then
				return
			end

			--==================================================
			-- STOP SOUND
			--==================================================

			local SavedSounds = {}

			for _, Object in ipairs(
				game:GetDescendants()
			) do

				if Object:IsA("Sound")
					and Object.IsPlaying then

					Object:Stop()

					table.insert(
						SavedSounds,
						Object
					)
				end
			end

			--==================================================
			-- JUMPSCARE SOUND
			--==================================================

			task.wait(0.3)

			local Sound =
				Instance.new("Sound")

			Sound.SoundId =
				"rbxassetid://103959751518518"

			Sound.Volume = 5

			Sound.Parent =
				Workspace

			Sound:Play()

			--==================================================
			-- MOVE A60
			--==================================================

			PrimaryPart.Anchored =
				true

			pcall(function()
				A60.PrimaryPart =
					PrimaryPart
			end)

			local TargetPosition =
				RootPart.Position
				+ RootPart.CFrame.LookVector * 10

			local MoveTween =
				TweenService:Create(

					PrimaryPart,

					TweenInfo.new(0.1),

					{
						CFrame =
							CFrame.new(
								TargetPosition,
								Camera.CFrame.Position
							)
					}
				)

			MoveTween:Play()

			MoveTween.Completed:Wait()

			--==================================================
			-- LOCK PLAYER
			--==================================================

			Humanoid.WalkSpeed = 0
			Humanoid.JumpPower = 0
			Humanoid.PlatformStand = true

			--==================================================
			-- CAMERA
			--==================================================

			local CameraConnection

			CameraConnection =
				RunService.RenderStepped:Connect(
					function()

						if not Character.Parent then
							return
						end

						-- Player hides
						if Character:GetAttribute(
							"Hiding"
						) then

							if CameraConnection then

								CameraConnection:Disconnect()

								CameraConnection =
									nil
							end

							for _, SavedSound in ipairs(
								SavedSounds
							) do

								if SavedSound
									and SavedSound.Parent then

									SavedSound:Play()
								end
							end

							PrimaryPart.Anchored =
								false

							Humanoid.PlatformStand =
								false

							return
						end

						if not PrimaryPart
							or not PrimaryPart.Parent then

							if CameraConnection then
								CameraConnection:Disconnect()
							end

							return
						end

						local DesiredPosition =
							Camera.CFrame.Position
							+ Camera.CFrame.LookVector * 5

						PrimaryPart.CFrame =
							CFrame.new(
								DesiredPosition,
								Camera.CFrame.Position
							)

						Camera.CFrame =
							CFrame.lookAt(
								Camera.CFrame.Position,
								PrimaryPart.Position
							)
					end
				)

			--==================================================
			-- IMAGE JUMPSCARE
			--==================================================

			task.wait(1.3)

			if Character:GetAttribute(
				"Hiding"
			) then
				return
			end

			local Images = {

				"82727826738371",

				"114398760531594",

				"109665802074437",

				"110910840590527",

				"71917470287498",

				"110105532069108",

				"79456435735915"
			}

			local Gui =
				Instance.new("ScreenGui")

			Gui.Name =
				"A60Jumpscare"

			Gui.IgnoreGuiInset =
				true

			Gui.ResetOnSpawn =
				false

			Gui.DisplayOrder =
				999999

			Gui.Parent =
				Player.PlayerGui

			local Image =
				Instance.new("ImageLabel")

			Image.Parent =
				Gui

			Image.BackgroundTransparency =
				1

			Image.AnchorPoint =
				Vector2.new(
					0.5,
					0.5
				)

			Image.Position =
				UDim2.new(
					0.5,
					0,
					0.5,
					0
				)

			Image.Size =
				UDim2.new(
					0,
					50,
					0,
					50
				)

			Image.ImageTransparency =
