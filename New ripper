--==================================================

entity:SetCallback("OnDamagePlayer", function(newHealth)

	if newHealth == 0 then
		print("Tuu has killed the player")
		return
	end

	print("Tuu has damaged the player")

	local player =
		Players.LocalPlayer

	local character =
		player.Character
		or player.CharacterAdded:Wait()

	local model =
		Workspace:WaitForChild("Tuu", 5)

	if not model then
		warn("Tuu model was not found")
		return
	end

	local part =
		model:FindFirstChild("Ripe")

	if not part then
		warn("Tuu model does not have a Ripe part!")
		return
	end

	local hrp =
		character:WaitForChild("HumanoidRootPart")

	part.Anchored = true

	local tween = TweenService:Create(
		part,
		TweenInfo.new(
			1,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			CFrame =
				hrp.CFrame * CFrame.new(0, 4, 0)
		}
	)

	tween:Play()

	task.wait(0.7)

	if character:GetAttribute("Hiding") then
		tween:Destroy()
		return
	end

	task.spawn(function()

		local humanoid =
			character:WaitForChild("Humanoid", 5)

		local humanoidRootPart =
			character:WaitForChild(
				"HumanoidRootPart"
			)

		local camera =
			Workspace.CurrentCamera

		local entityModel =
			Workspace:WaitForChild("Tuu", 5)

		if not entityModel then
			return
		end

		local primaryPart =
			entityModel:FindFirstChild("Ripe")

		if not (
			entityModel
			and humanoid
			and humanoidRootPart
			and primaryPart
			and camera
		) then
			return
		end

		local originalWalkSpeed =
			humanoid.WalkSpeed

		local originalJumpPower =
			humanoid.JumpPower

		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0

		local controlsModule =
			require(
				player
					:WaitForChild("PlayerScripts")
					:WaitForChild("PlayerModule")
			):GetControls()

		controlsModule:Disable()

		--==================================================
		-- PARTICLES
		--==================================================

		local function SetAllParticlesTimeScale(
			targetModel,
			timescale
		)
			for _, descendant in ipairs(
				targetModel:GetDescendants()
			) do
				if descendant:IsA("ParticleEmitter") then
					descendant.TimeScale = timescale
				end
			end
		end

		SetAllParticlesTimeScale(
			entityModel,
			1
		)

		local running = true

		--==================================================
		-- FOLLOW PLAYER
		--==================================================

		task.spawn(function()

			while
				running
				and primaryPart
				and primaryPart.Parent
				and humanoidRootPart
				and humanoidRootPart.Parent
			do

				local targetCFrame =
					humanoidRootPart.CFrame

				local followTween =
					TweenService:Create(
						primaryPart,
						TweenInfo.new(
							2000000000000,
							Enum.EasingStyle.Quad
						),
						{
							CFrame = targetCFrame
						}
					)

				followTween:Play()
				followTween.Completed:Wait()
			end
		end)

		--==================================================
		-- FACE PARTICLE
		--==================================================

		local ripeAttachment =
			primaryPart:FindFirstChild(
				"Attachment",
				true
			)

		if ripeAttachment then

			local emitter =
				ripeAttachment:FindFirstChild(
					"Face1"
				)

			if emitter then

				emitter.Texture =
					"rbxassetid://12737595583"

				emitter.Size =
					NumberSequence.new(10)

				emitter.Squash =
					NumberSequence.new(0)

				emitter.Enabled = true
				emitter:Emit(20)

				task.wait(0.1)

				emitter.TimeScale = 0
			end
		end

		--==================================================
		-- CAMERA
		--==================================================

		camera.CameraType =
			Enum.CameraType.Scriptable

		local lockConnection

		lockConnection =
			RunService.RenderStepped:Connect(
				function()

					if
						not primaryPart
						or not primaryPart.Parent
					then

						if lockConnection then
							lockConnection:Disconnect()
						end

						return
					end

					camera.CFrame =
						CFrame.lookAt(
							camera.CFrame.Position,
							primaryPart.Position
						)
				end
			)

		task.wait(0.35)

		SetAllParticlesTimeScale(
			entityModel,
			0
		)

		--==================================================
		-- GITHUB JUMPSCARE SOUND
		--==================================================

		local function GetGitSound(
			GithubSnd,
			SoundName
		)

			if not isfile(
				SoundName .. ".mp3"
			) then

				writefile(
					SoundName .. ".mp3",
					game:HttpGet(GithubSnd)
				)
			end

			local newSound =
				Instance.new("Sound")

			newSound.SoundId =
				(getcustomasset or getsynasset)(
					SoundName .. ".mp3"
				)

			return newSound
		end

		local Jumpscare = GetGitSound(
			"https://github.com/eoyoustme/back/raw/main/Kill_with_static.mp3",
			"Kill"
		)

		Jumpscare.Parent = workspace
		Jumpscare.Volume = 1
		Jumpscare.PlaybackSpeed = 1

		local sound =
			Instance.new("Sound", workspace)

		sound.SoundId =
			"rbxassetid://1837829565"

		sound.Volume = 10
		sound.PlaybackSpeed = 1
		sound:Play()

		-- Tắt sound bên trong Tuu
		for _, descendant in ipairs(
			entityModel:GetDescendants()
		) do

			if descendant:IsA("Sound") then
				descendant.Playing = false
				descendant.Volume = 0
			end
		end

		Jumpscare:Play()

		task.wait(1)

		--==================================================
		-- JUMPSCARE GUI
		--==================================================

		local screenGui =
			Instance.new("ScreenGui")

		screenGui.Name =
			"JumpscareOverlay"

		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 999999

		screenGui.Parent =
			player:WaitForChild("PlayerGui")

		local imageLabel =
			Instance.new("ImageLabel")

		imageLabel.BackgroundTransparency = 1
		imageLabel.BorderSizePixel = 0
		imageLabel.Position =
			UDim2.new(0, 0, 0, 0)

		imageLabel.Size =
			UDim2.new(1, 0, 1, 0)

		imageLabel.ScaleType =
			Enum.ScaleType.Stretch

		imageLabel.ImageTransparency = 1
		imageLabel.Visible = true

		imageLabel.Parent =
			screenGui

		local jumpscareImage1 =
			"rbxassetid://96053934105572"

		local jumpscareImage2 =
			"rbxassetid://118557662033092"

		local jumpscareImage3 =
			"rbxassetid://126619556414034"

		local jumpscareImage4 =
			"rbxassetid://78199392475572"

		local flashDuration = 1.6

		imageLabel.Image =
			jumpscareImage1

		local tweenIn =
			TweenInfo.new(
				0.8,
				Enum.EasingStyle.Linear
			)

		TweenService:Create(
			imageLabel,
			tweenIn,
			{
				ImageTransparency = 0
			}
		):Play()

		local start = tick()

		while tick() - start < flashDuration do

			imageLabel.Image =
				jumpscareImage1

			task.wait()

			imageLabel.Image =
				jumpscareImage2

			task.wait()

			imageLabel.Image =
				jumpscareImage3

			task.wait()

			imageLabel.Image =
				jumpscareImage4

			task.wait()
		end

		imageLabel.ImageTransparency = 1

		task.wait()

		running = false

		--==================================================
		-- KILL
		--==================================================

		if humanoid then
			humanoid.Health = 0
		end

		local deathSound =
			Instance.new("Sound")

		deathSound.SoundId =
			"rbxassetid://4988621968"

		deathSound.Volume = 10
		deathSound.PlaybackSpeed = 0.7
		deathSound.Parent = workspace
		deathSound:Play()

		if entityModel
			and entityModel.Parent
		then
			entityModel:Destroy()
		end

		if lockConnection then
			lockConnection:Disconnect()
		end

		camera.CameraType =
			Enum.CameraType.Custom

		if screenGui
			and screenGui.Parent
		then
			screenGui:Destroy()
		end

		if humanoid
			and humanoid.Health > 0
		then

			humanoid.WalkSpeed =
				originalWalkSpeed

			humanoid.JumpPower =
				originalJumpPower

			controlsModule:Enable()
		end
	end)
end)

