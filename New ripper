--==================================================
-- WH1TLY RED ROOM LIGHT SYSTEM
--==================================================

local RedLightsActive = false
local OriginalLightColors = {}
local OriginalPartColors = {}
local CurrentRedRoom = nil

local function GetPlayerRoom()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")

	if not currentRooms then
		return nil
	end

	local character = Player.Character

	if not character then
		return nil
	end

	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not hrp then
		return nil
	end

	-- First try LatestRoom
	local gameData = game.ReplicatedStorage:FindFirstChild("GameData")
	local latestRoom = gameData and gameData:FindFirstChild("LatestRoom")

	if latestRoom then
		local room = currentRooms:FindFirstChild(
			tostring(latestRoom.Value)
		)

		if room then
			CurrentRedRoom = room
			return room
		end
	end

	-- Fallback: find closest room to player
	local closestRoom = nil
	local closestDistance = math.huge

	for _, room in ipairs(currentRooms:GetChildren()) do
		if room:IsA("Model") then
			local roomPart =
				room:FindFirstChild("RoomStart")
				or room:FindFirstChild("RoomEnd")
				or room.PrimaryPart
				or room:FindFirstChildWhichIsA("BasePart")

			if roomPart then
				local distance =
					(hrp.Position - roomPart.Position).Magnitude

				if distance < closestDistance then
					closestDistance = distance
					closestRoom = room
				end
			end
		end
	end

	CurrentRedRoom = closestRoom

	return closestRoom
end

local function MakeRoomRed()
	if RedLightsActive then
		return
	end

	local room = GetPlayerRoom()

	if not room then
		warn("Tuu: player room not found")
		return
	end

	RedLightsActive = true
	CurrentRedRoom = room

	OriginalLightColors = {}
	OriginalPartColors = {}

	--==================================================
	-- REAL LIGHTS
	--==================================================

	for _, object in ipairs(room:GetDescendants()) do

		if object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight") then

			OriginalLightColors[object] = object.Color

			object.Color = Color3.fromRGB(
				255,
				0,
				0
			)
		end
	end

	--==================================================
	-- LIGHT FIXTURE PARTS
	--==================================================

	for _, object in ipairs(room:GetDescendants()) do

		if object:IsA("BasePart") then

			local name = object.Name:lower()

			if name:find("light")
				or name:find("lamp")
				or name:find("bulb")
				or name:find("ceiling") then

				OriginalPartColors[object] =
					object.Color

				object.Color = Color3.fromRGB(
					255,
					0,
					0
				)
			end
		end
	end

	print("Tuu: room lights turned red")
end

local function RestoreRoomLights()
	if not RedLightsActive then
		return
	end

	-- Restore actual lights
	for object, oldColor in pairs(
		OriginalLightColors
	) do

		if object
			and object.Parent
		then
			pcall(function()
				object.Color = oldColor
			end)
		end
	end

	-- Restore fixture parts
	for object, oldColor in pairs(
		OriginalPartColors
	) do

		if object
			and object.Parent
		then
			pcall(function()
				object.Color = oldColor
			end)
		end
	end

	OriginalLightColors = {}
	OriginalPartColors = {}

	CurrentRedRoom = nil
	RedLightsActive = false

	print("Tuu: room lights restored")
end

