entity:SetCallback("OnDespawning", function()
	print("Tuu is despawning")

	local CameraShaker =
		require(game.ReplicatedStorage.CameraShaker)

	local camera = workspace.CurrentCamera

	local camShake = CameraShaker.new(
		Enum.RenderPriority.Camera.Value,
		function(shakeCf)
			camera.CFrame =
				camera.CFrame * shakeCf
		end
	)

	camShake:Start()

	camShake:ShakeOnce(
		10,
		3.5,
		0.1,
		1,
		15,
		0.5
	)

	local sound = Instance.new(
		"Sound",
		workspace
	)

	sound.SoundId = "rbxassetid://6657340839"
	sound.Volume = 10
	sound.PlaybackSpeed = 1
	sound:Play()

	task.wait(0.65)

	local TweenService =
		game:GetService("TweenService")

	TweenService:Create(
		sound,
		TweenInfo.new(
			1,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			PlaybackSpeed = 0
		}
	):Play()

	task.wait(0.85)

	local camShake2 = CameraShaker.new(
		Enum.RenderPriority.Camera.Value,
		function(shakeCf)
			camera.CFrame =
				camera.CFrame * shakeCf
		end
	)

	camShake2:Start()

	camShake2:ShakeOnce(
		30,
		11.5,
		0.1,
		2,
		15,
		0.5
	)

	local sound5 = Instance.new(
		"Sound",
		workspace
	)

	sound5.SoundId = "rbxassetid://1837829565"
	sound5.Volume = 10
	sound5.PlaybackSpeed = 1
	sound5:Play()

	--==================================================
	-- ACHIEVEMENT
	--==================================================

	local achievementGiver = loadstring(
		game:HttpGet(
			"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
		)
