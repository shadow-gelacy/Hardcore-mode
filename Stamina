local function updateStaminaBar()
	local percent = math.clamp(
		stamina / staminaMax,
		0,
		1
	)

	Fill.Size = UDim2.new(
		percent,
		1,
		1,
		0
	)
end

local function updateSpeed()
	if not Hum or Hum.Health <= 0 then
		return
	end

	if MainGame then
		if MainGame.chase then

			if MainGame.crouching then
				Hum.WalkSpeed = CHASE_CROUCH_SPEED
			else
				Hum.WalkSpeed = CHASE_SPEED
			end

		elseif MainGame.crouching then

			Hum.WalkSpeed = CROUCH_SPEED

		elseif isSprinting then

			Hum.WalkSpeed = SPRINT_SPEED

		else

			Hum.WalkSpeed = NORMAL_SPEED
		end

	else

		if isSprinting then
			Hum.WalkSpeed = SPRINT_SPEED
		else
			Hum.WalkSpeed = NORMAL_SPEED
		end
	end
end

if hookmetamethod and newcclosure then

	local oldNewIndex

	oldNewIndex = hookmetamethod(
		game,
		"__newindex",
		newcclosure(function(t, k, v)

			if t == Hum and k == "WalkSpeed" then

				if MainGame then

					if MainGame.chase then

						if MainGame.crouching then
							v = CHASE_CROUCH_SPEED
						else
							v = CHASE_SPEED
						end

					elseif MainGame.crouching then

						v = CROUCH_SPEED

					elseif isSprinting then

						v = SPRINT_SPEED

					else

						v = NORMAL_SPEED
					end

				else

					if isSprinting then
						v = SPRINT_SPEED
					else
						v = NORMAL_SPEED
					end
				end
			end

			return oldNewIndex(
				t,
				k,
				v
			)
		end)
	)
end

local function startSprint()

	if cooldown then
		return
	end

	if not Hum or Hum.Health <= 0 then
		return
	end

	if stamina <= 0 then
		return
	end

	if MainGame and MainGame.crouching then
		return
	end

	if isSprinting then
		return
	end

	isSprinting = true

	Hum:SetAttribute(
		"SpeedBoost",
		SPEED_BOOST
	)

	updateSpeed()

	TweenService:Create(
		BlackImage,
		TweenInfo.new(12),
		{
			ImageTransparency = 0
		}
	):Play()
end

local function stopSprint()

	if not isSprinting then
		return
	end

	isSprinting = false

	if Hum then
		Hum:SetAttribute(
			"SpeedBoost",
			0
		)
	end

	updateSpeed()

	TweenService:Create(
		BlackImage,
		TweenInfo.new(1),
		{
			ImageTransparency = 1
		}
	):Play()
end

UIS.InputBegan:Connect(function(
	input,
	processed
)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then

		if isSprinting then
			stopSprint()
		else
			startSprint()
		end
	end
end)

MobileButton.Activated:Connect(function()

