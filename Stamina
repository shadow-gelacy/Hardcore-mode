--==================================================
-- STAMINA LOOP
--==================================================

local staminaLoop = 0

RunService.Heartbeat:Connect(function(deltaTime)

	if not Hum or Hum.Health <= 0 then
		return
	end

	--==============================================
	-- SPRINT
	--==============================================

	if isSprinting then

		staminaLoop += deltaTime

		-- Giữ đúng tốc độ drain của script gốc:
		-- 100 stamina trong sprintTime giây
		local drainPerSecond =
			staminaMax / sprintTime

		stamina -= drainPerSecond * deltaTime

		if stamina <= 0 then

			stamina = 0

			stopSprint()

			cooldown = true

			-- Caption
			pcall(function()

				firesignal(
					game.ReplicatedStorage.Bricks.Caption.OnClientEvent,
					"You're exhausted."
				)

			end)

			-- Exhaust sound
			pcall(function()

				local sound = Instance.new("Sound")
				sound.SoundId =
					"rbxassetid://8258601891"
				sound.Volume = 0.8
				sound.PlayOnRemove = true
				sound.Parent = workspace
				sound:Destroy()

			end)

			-- Black effect
			TweenService:Create(
				BlackImage,
				TweenInfo.new(0.3),
				{
					ImageTransparency = 0
				}
			):Play()

			task.wait(0.3)

			TweenService:Create(
				BlackImage,
				TweenInfo.new(10),
				{
					ImageTransparency = 1
				}
			):Play()

			--==========================================
			-- FULL RECOVERY
			--==========================================

			for i = 1, staminaMax do

				stamina = i

				updateStaminaBar()

				task.wait(
					sprintTime / 50
				)

			end

			cooldown = false
		end

	--==============================================
	-- REGEN
	--==============================================

	else

		if not cooldown and stamina < staminaMax then

			stamina = math.min(
				stamina + 1,
				staminaMax
			)

			updateStaminaBar()

			task.wait(
				sprintTime / 50
			)
		end
	end

	stamina = math.clamp(
		stamina,
		0,
		staminaMax
	)

	updateStaminaBar()

end)

