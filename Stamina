--==================================================
-- UPDATE STAMINA BAR
--==================================================

local function updateStaminaBar()
	local percent = math.clamp(
		stamina / staminaMax,
		0,
		1
	)

	Fill.Size = UDim2.new(
		percent,
		1,
		1,
		0
	)
end

--==================================================
-- SPEED SYSTEM
--==================================================

local function updateSpeed()
	if not Hum or Hum.Health <= 0 then
		return
	end

	if not MainGame then
		Hum.WalkSpeed = isSprinting and SPRINT_SPEED or NORMAL_SPEED
		return
	end

	if MainGame.chase then

		if MainGame.crouching then
			Hum.WalkSpeed = CHASE_CROUCH_SPEED
		else
			Hum.WalkSpeed = CHASE_SPEED
		end

	elseif MainGame.crouching then

		Hum.WalkSpeed = CROUCH_SPEED

	elseif isSprinting then

		-- QUAN TRỌNG:
		-- Sprint sẽ được set 20 ngay lập tức
		Hum.WalkSpeed = SPRINT_SPEED

	else

		Hum.WalkSpeed = NORMAL_SPEED
	end
end

--==================================================
-- HOOK WALKSPEED
--==================================================

if hookmetamethod and newcclosure then

	local oldNewIndex

	oldNewIndex = hookmetamethod(
		game,
		"__newindex",
		newcclosure(function(t, k, v)

			if t == Hum and k == "WalkSpeed" then

				if MainGame then

					if MainGame.chase then

						v = MainGame.crouching
							and CHASE_CROUCH_SPEED
							or CHASE_SPEED

					elseif MainGame.crouching then

						v = CROUCH_SPEED

					elseif isSprinting then

						v = SPRINT_SPEED

					else

						v = NORMAL_SPEED
					end

				else

					v = isSprinting
						and SPRINT_SPEED
						or NORMAL_SPEED
				end
			end

			return oldNewIndex(t, k, v)
		end)
	)

end

--==================================================
-- START SPRINT
--==================================================

local function startSprint()

	if cooldown then
		return
	end

	if not Hum or Hum.Health <= 0 then
		return
	end

	if stamina <= 0 then
		return
	end

	if MainGame and MainGame.crouching then
		return
	end

	if isSprinting then
		return
	end

	isSprinting = true

	-- SpeedBoost gốc
	Hum:SetAttribute(
		"SpeedBoost",
		SPEED_BOOST
	)

	-- FIX:
	-- set WalkSpeed ngay khi bấm
	updateSpeed()

	TweenService:Create(
		BlackImage,
		TweenInfo.new(12),
		{
			ImageTransparency = 0
		}
	):Play()
end

--==================================================
-- STOP SPRINT
--==================================================

local function stopSprint()

	if not isSprinting then
		return
	end

	isSprinting = false

	Hum:SetAttribute(
		"SpeedBoost",
		0
	)

	updateSpeed()

	TweenService:Create(
		BlackImage,
		TweenInfo.new(1),
		{
			ImageTransparency = 1
		}
	):Play()
end

--==================================================
-- PC Q TOGGLE
--==================================================

UIS.InputBegan:Connect(function(input, processed)

	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Q then

		if isSprinting then
			stopSprint()
		else
			startSprint()
		end

	end
end)

