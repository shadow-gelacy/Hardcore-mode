	if stamina <= 0 then
		return
	end

	if isSprinting then
		stopSprint()
	else
		startSprint()
	end
end)

local function exhaust()

	if exhaustedEffectRunning then
		return
	end

	exhaustedEffectRunning = true
	cooldown = true

	stopSprint()

	pcall(function()

		local Bricks =
			game.ReplicatedStorage:FindFirstChild(
				"Bricks"
			)

		if Bricks then

			local Caption =
				Bricks:FindFirstChild(
					"Caption"
				)

			if Caption then

				firesignal(
					Caption.OnClientEvent,
					"You're exhausted."
				)
			end
		end
	end)

	pcall(function()

		local sound =
			Instance.new("Sound")

		sound.SoundId =
			"rbxassetid://8258601891"

		sound.Volume = 0.8
		sound.PlayOnRemove = true
		sound.Parent = workspace

		sound:Destroy()
	end)

	TweenService:Create(
		BlackImage,
		TweenInfo.new(0.3),
		{
			ImageTransparency = 0
		}
	):Play()

	task.delay(
		0.3,
		function()

			TweenService:Create(
				BlackImage,
				TweenInfo.new(10),
				{
					ImageTransparency = 1
				}
			):Play()
		end
	)

	stamina = 0
	updateStaminaBar()

	task.spawn(function()

		local recoveryTime = sprintTime

		local stepTime =
			recoveryTime / staminaMax

		for i = 1, staminaMax do

			if not Hum or Hum.Health <= 0 then
				break
			end

			stamina = i

			updateStaminaBar()

			task.wait(stepTime)
		end

		stamina = staminaMax

		updateStaminaBar()

		cooldown = false
		exhaustedEffectRunning = false
	end)
end

RunService.Heartbeat:Connect(function(deltaTime)

	if not Hum or Hum.Health <= 0 then
		return
	end

	if isSprinting then

		local drainPerSecond =
			staminaMax / sprintTime

		stamina -=
			drainPerSecond * deltaTime

		if stamina <= 0 then

			stamina = 0

			updateStaminaBar()

			exhaust()

			return
		end

	else

		if not cooldown and stamina < staminaMax then

			local regenPerSecond =
				staminaMax / sprintTime

			stamina +=
				regenPerSecond * deltaTime

			if stamina > staminaMax then
				stamina = staminaMax
			end
		end
	end

	stamina = math.clamp(
		stamina,
		0,
		staminaMax
	)

	updateStaminaBar()
end)

task.spawn(function()

	while task.wait(0.1) do

		if Hum and Hum.Health > 0 then
			updateSpeed()
		end
	end
end)

Hum:SetAttribute(
	"SpeedBoost",
	0
)

Hum.WalkSpeed = NORMAL_SPEED

updateStaminaBar()
